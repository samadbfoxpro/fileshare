<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FileShareSetup</AssemblyName>
    <RootNamespace>FileShareSetup</RootNamespace>
    <ApplicationIcon>..\..\wwwroot\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Payload\FileShare.exe" LogicalName="Payload.FileShare.exe" />
    <EmbeddedResource Include="Payload\WebView2Loader.dll" LogicalName="Payload.WebView2Loader.dll" />
    <EmbeddedResource Include="Payload\uninstall.ps1" LogicalName="Payload.uninstall.ps1" />
  </ItemGroup>

</Project>
